{
  "manifest_version": 3,
  "name": "TikTok 运营台助手",
  "version": "1.3.0",
  "description": "选好运营台里的商品，自动到 1688 搜货采集；也可以把 FastMoss 当前页的商品发到运营台（不占导出次数）。",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.1688.com/*",
    "https://*.fastmoss.com/*",
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "TikTok 运营台助手",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.1688.com/*"
      ],
      "js": [
        "main-1688.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.1688.com/*"
      ],
      "js": [
        "content-1688.js"
      ],
      "css": [
        "panel.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.fastmoss.com/*"
      ],
      "js": [
        "content-fastmoss.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
